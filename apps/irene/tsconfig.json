{
  "extends": "@tsconfig/ember/tsconfig.json",
  "compilerOptions": {
    // `paths` maps Ember's classic package layout, which is not resolvable with
    // the Node resolution algorithm, onto real directories. It is written
    // relative to this file: `baseUrl` is deprecated and removed in TS 7.
    "declarationMap": false,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false, // TODO: remove this later
    "paths": {
      // Mapped to the declarations: a path to the runtime package shadows them.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      // Declared rather than followed: the React side ships built JavaScript.
      "@irene/dashboard/embed": ["./types/irene-embed.d.ts"],
      "fetch": ["./node_modules/ember-fetch"],
      "irene/tests/*": ["./tests/*"],
      "irene/mirage/*": ["./mirage/*"],
      "irene/translations/*": ["./translations/*"],
      "irene/*": ["./app/*"],
      "*": ["./types/*"]
    }
  },
  "glint": {
    "environment": "ember-loose"
  },
  "include": ["app/**/*", "tests/**/*", "types/**/*", "mirage/**/*"]
}
