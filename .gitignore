node_modules/
dist/
build/
coverage/
/tmp/

# Turborepo and TanStack Router each write cache directories at the root and
# per package, including compressed tarballs.
.turbo/
.tanstack/
.eslintcache
*.tsbuildinfo

.env
.env.*
!.env.example

.DS_Store
*.log
npm-debug.log*

# Editor settings are committed on purpose: Tailwind v4 uses @theme, @source and
# @custom-variant, none of which the built-in CSS parser knows, so without these
# every developer sees the same false error.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Planning documents
migration/

storybook-static/

# Local Netlify folder
.netlify

# cypress
cypress.env.json
/cypress/downloads/
/cypress/snapshots/actual
/cypress/snapshots/diff

# Generated from src/routes by the router plugin
routeTree.gen.ts

# Generated from translations/ by packages/translations/scripts/generate.ts
packages/translations/src/generated/

# The Ember app, cloned in for the proxy that serves both from one origin. It
# has its own repository and its own npm install, so it is not committed here.

# Reference material, cloned rather than vendored.
apps/ast-workshop
