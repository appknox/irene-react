diff --git a/app/modifiers/react.ts b/app/modifiers/react.ts
new file mode 100644
index 0000000..933965b
--- /dev/null
+++ b/app/modifiers/react.ts
@@ -0,0 +1,95 @@
+import { registerDestructor } from '@ember/destroyable';
+import { service } from '@ember/service';
+import type RouterService from '@ember/routing/router-service';
+import Modifier from 'ember-modifier';
+import { createElement, type ComponentType } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+
+interface ReactModifierSignature {
+  Element: Element;
+  Args: {
+    Positional: [ComponentType<Record<string, unknown>>];
+    Named: Record<string, unknown>;
+  };
+}
+
+/** Whether a click asked for this document, rather than a new tab or a download. */
+function isPlainClick(event: MouseEvent) {
+  return (
+    !event.defaultPrevented &&
+    event.button === 0 &&
+    !event.metaKey &&
+    !event.ctrlKey &&
+    !event.shiftKey &&
+    !event.altKey
+  );
+}
+
+/**
+ * Renders a React component into the element this modifies.
+ *
+ * Glimmer only reconciles nodes bound to tracked values, so the element handed
+ * over here is left alone and React owns everything inside it. A changed
+ * argument renders again into the same root rather than replacing it, which is
+ * what lets the React tree keep its own state across an update.
+ *
+ * Links inside the tree are handed to this app's router. The React tree has a
+ * router of its own — its components need one — but that router holds only the
+ * screen being embedded, so a link left to it resolves to nothing.
+ */
+export default class ReactModifier extends Modifier<ReactModifierSignature> {
+  @service declare router: RouterService;
+
+  #root?: Root;
+
+  /* Capture phase, so the link is claimed before React's own handler sees the click. */
+  #claimLink = (event: MouseEvent) => {
+    if (!isPlainClick(event)) {
+      return;
+    }
+
+    const anchor = (event.target as Element | null)?.closest?.('a[href]');
+    const href = anchor?.getAttribute('href');
+
+    if (!href || anchor?.getAttribute('target') === '_blank') {
+      return;
+    }
+
+    /* Anything off this origin is the browser's to handle, as are mail and tel links. */
+    if (!href.startsWith('/')) {
+      return;
+    }
+
+    event.preventDefault();
+    event.stopPropagation();
+
+    if (this.router.recognize(href)) {
+      this.router.transitionTo(href);
+    } else {
+      window.location.assign(href);
+    }
+  };
+
+  modify(
+    element: Element,
+    [component]: [ComponentType<Record<string, unknown>>],
+    named: Record<string, unknown>
+  ) {
+    if (!this.#root) {
+      this.#root = createRoot(element);
+
+      element.addEventListener('click', this.#claimLink as EventListener, true);
+
+      registerDestructor(this, () => {
+        element.removeEventListener('click', this.#claimLink as EventListener, true);
+        this.#root?.unmount();
+      });
+    }
+
+    /*
+      Copied onto a plain object: React reads `key` and `ref` off whatever it
+      is given, and the args proxy throws for any name it was not passed.
+    */
+    this.#root.render(createElement(component, { ...named }));
+  }
+}
