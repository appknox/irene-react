+++ b/app/components/react-page.ts
@@ -0,0 +1,22 @@
+import Component from '@glimmer/component';
+
+import { IrenePage } from '@irene/dashboard/embed';
+
+interface ReactPageSignature {
+  Element: HTMLDivElement;
+  Args: {
+    /** The page to render, where it is not the one this app's URL names. */
+    path?: string;
+  };
+}
+
+/**
+ * Renders the React app's page for a route this app no longer draws itself.
+ *
+ * A migrated screen's template is this component and nothing else. The page is
+ * chosen by the URL, so there is nothing to register and nothing to pass.
+ */
+export default class ReactPageComponent extends Component<ReactPageSignature> {
+  /* A classic template cannot import, so the React component is reached through here. */
+  IrenePage = IrenePage;
+}
