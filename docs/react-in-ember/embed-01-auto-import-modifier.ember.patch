diff --git a/types/irene-embed.d.ts b/types/irene-embed.d.ts
new file mode 100644
index 0000000..9dd13fe
--- /dev/null
+++ b/types/irene-embed.d.ts
@@ -0,0 +1,14 @@
+/*
+  What this app imports from the React side.
+
+  The React packages are type-checked by their own toolchain, against their own
+  dependencies. Following them from here would mean teaching this app's
+  TypeScript about every package the React app installs, so the boundary is
+  declared instead.
+*/
+declare module '@irene/dashboard/embed' {
+  import type { ComponentType, ReactNode } from 'react';
+
+  export const IrenePage: ComponentType<{ path?: string }>;
+  export const EmbedProviders: ComponentType<{ children: ReactNode }>;
+}
