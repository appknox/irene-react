{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "@testing-library/jest-dom"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    // The shadcn CLI resolves its aliases through these. TypeScript itself
    // reads the package exports map, so they only have to agree with it.
    "paths": {
      "@irene/ui": ["./src/index.ts"],
      "@irene/ui/cn": ["./src/utils/cn/index.ts"],
      "@irene/ui/styles/*": ["./styles/*"],
      "@irene/ui/*": ["./src/components/*/index.tsx"]
    }
  },
  "include": ["src", "styles", "tests", "scripts", ".storybook/**/*", "vitest.config.ts"]
}
