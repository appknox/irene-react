{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "vite-plugin-svgr/client", "@testing-library/jest-dom"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@irene/ui": ["./src/index.ts"],
      "@irene/ui/cn": ["./src/utils/cn/index.ts"],
      "@irene/ui/ui": ["./src/components/ui"],
      "@irene/ui/styles/*": ["./styles/*"],
      "@irene/ui/*/variants": ["./src/components/*/variants.ts"],
      "@irene/ui/*/context": ["./src/components/*/context.ts"],
      "@irene/ui/*": ["./src/components/*/index.tsx"]
    }
  },
  "include": ["src", "styles", "tests", "scripts", "vite", ".storybook/**/*", "vitest.config.ts"]
}
